{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/stray.txt",
        "color": {
            "1": "magenta"
        },
        "padding": {
            "top": 2,
            "left": 3,
            "right": 4
        }
    },
    "display": {
        "separator": "    ",
        "color": {
            "keys": "magenta"
        },
        "size": {
            "maxPrefix": "MB",
            "ndigits": 0
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "magenta",
                "at": "white",
                "host": "magenta"
            }
        },
        "break",
        {
            "type": "os",
            "key": "OS "
        },
        {
            "type": "kernel",
            "key": "KER"
        },
        {
            "type": "uptime",
            "key": "UP "
        },
        {
            "type": "packages",
            "key": "PKG"
        },
        {
            "type": "wm",
            "key": "WM "
        },
        {
            "type": "terminal",
            "key": "TRM"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}